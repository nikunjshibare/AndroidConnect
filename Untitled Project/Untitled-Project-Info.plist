<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>AndroidConnect</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AndroidConnect uses the local network to discover and communicate with the companion app on your Android phone.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>AndroidConnect uses Bluetooth to route phone call audio through your Mac.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_androidconnect._tcp</string>
	</array>
</dict>
</plist>
